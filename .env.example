# Обязательные
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_ID=
GEMINI_API_KEY=
# Полный путь к папке хранилища Obsidian (там, где лежат ваши заметки)
OBSIDIAN_VAULT_PATH=/path/to/your/vault

# Необязательные
# Имя хранилища для ссылок obsidian:// (как оно называется в Obsidian)
OBSIDIAN_VAULT_NAME=Obsidian Vault
# Модель Gemini (есть и более новая: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.6-flash
# Где бот хранит свои данные (карточки, журнал учёбы, кнопки)
DATA_DIR=./data
# Час ежедневного напоминания (0-23) или off, чтобы отключить
REMINDER_HOUR=9
# Файл cookies.txt для yt-dlp (если YouTube просит войти)
YT_COOKIES_PATH=
# Прокси для yt-dlp, например http://127.0.0.1:3067
YTDLP_PROXY=
